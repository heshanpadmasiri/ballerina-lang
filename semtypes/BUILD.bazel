package(default_visibility = ["//visibility:public"])

java_library(
    name = "semtypes",
    srcs = glob([
        "src/main/java/**/*.java",
    ]),
    visibility = ["//visibility:public"],
    deps = [],
)

load("@j2cl//build_defs:rules.bzl", "j2cl_library")

j2cl_library(
    name = "semtypes-j2cl",
    srcs = glob([
        "src/main/java/**/*.java",
    ], exclude=["src/main/java/module-info.java", "src/main/java/**/BasicTypeCode.java", "src/main/java/**/Env.java", "src/main/java/**/ComplexSemType.java", "src/main/java/**/ListOps.java", "src/main/java/**/Core.java", "src/main/java/**/ListDefinition.java", "src/main/java/**/MappingDefinition.java", "src/main/java/**/ObjectDefinition.java", "src/main/java/**/ListProj.java"]) + glob([
        "super-j2cl/**/*.java",
    ]),
    deps = [],
    javacopts = [
        "-source", "21",
        "-target", "21",
    ],
)

{
  "name": "JBallerina bazel container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers-community/features/bazel:1": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "distribution": "adoptium"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.vscode-java-pack",
        "bazelbuild.vscode-bazel",
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-test",
        "anthropic.claude-code"
      ]
    }
  },
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && echo 'Development environment ready! Claude Code installed.'",
  "remoteUser": "vscode",
  "containerEnv": {
    "CLAUDE_CODE_ENABLED": "true"
  }
}
